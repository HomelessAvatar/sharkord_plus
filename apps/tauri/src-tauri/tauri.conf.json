{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "VibeShark",
  "version": "0.3.6",
  "identifier": "com.sharkord.plus",
  "build": {
    "beforeDevCommand": "bun --filter client dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --filter client build",
    "frontendDist": "../../../apps/client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VibeShark",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 24
    }
  }
}
